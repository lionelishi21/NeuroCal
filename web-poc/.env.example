# Base URL of the NeuroCal API. Leave unset to use the built-in mock API.
NEXT_PUBLIC_API_URL=
# Cognito user pool of a deployed stage (infra outputs UserPoolId / UserPoolClientId).
# Leave both unset to use the built-in mock sign-in (accounts stay in this browser; every code is 123456).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
