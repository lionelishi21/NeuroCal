{
  "openapi": "3.1.0",
  "info": {
    "title": "NeuroCal API",
    "version": "0.1.0",
    "description": "Generated from packages/contracts (Zod). Do not edit by hand: change the contract and run `npm run openapi`."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local backend (`npm run dev` in backend)"
    }
  ],
  "security": [
    {
      "cognitoIdToken": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the profile and targets",
        "description": "404 until the profile has been set up.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/me/profile": {
      "put": {
        "operationId": "updateProfile",
        "summary": "Create or update the profile",
        "description": "The first save creates the profile and needs displayName, dietaryPreference, dailyCalorieTarget and macroTargets. Later saves can be partial.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/bio-state": {
      "get": {
        "operationId": "getBioState",
        "summary": "Get a day's intake against its targets",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Calendar day in the user's time zone, e.g. 2026-09-29. Defaults to today.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BioState"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/check-ins": {
      "post": {
        "operationId": "createCheckIn",
        "summary": "Record how the user feels",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCheckInRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckIn"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/uploads/meal-photo": {
      "post": {
        "operationId": "createPhotoUpload",
        "summary": "Get a short-lived URL to upload a meal photo to",
        "description": "PUT the photo's bytes to `uploadUrl` with exactly the returned `headers`, then pass `photoKey` to POST /meals/analyze. The photo must be an image of at most 8 MB, and the bytes sent must match `sizeBytes`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePhotoUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoUpload"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/meals/analyze": {
      "post": {
        "operationId": "analyzeMeal",
        "summary": "Propose food items from a meal photo",
        "description": "Send the `photoKey` of an uploaded photo as JSON, or the photo itself as multipart. Nothing is saved. A photo that can't be read is a normal 200 response with `problem` set.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeMealRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "The meal photo (JPEG, PNG, WebP or HEIC)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeMealResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/meals": {
      "post": {
        "operationId": "createMeal",
        "summary": "Log a confirmed meal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMealRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meal"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "listMeals",
        "summary": "List a day's meals, earliest first",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Calendar day in the user's time zone, e.g. 2026-09-29. Defaults to today.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MealList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/meals/{id}": {
      "delete": {
        "operationId": "deleteMeal",
        "summary": "Remove a meal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The meal's id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done; no content"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/recommendations/next": {
      "get": {
        "operationId": "nextRecommendations",
        "summary": "Suggest recipes for the current bio-state",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextRecommendationsResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/focus-score": {
      "get": {
        "operationId": "getFocusScore",
        "summary": "Get a day's Focus Score with its inputs and explanation",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Calendar day in the user's time zone, e.g. 2026-09-29. Defaults to today.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FocusScore"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/history": {
      "get": {
        "operationId": "getHistory",
        "summary": "Get the last N days, oldest first",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "How many days, ending today. Defaults to 7.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/recommendations/protocols": {
      "get": {
        "operationId": "getProtocols",
        "summary": "Suggest protocols and products for the week's weak points",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolsResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admin/products": {
      "get": {
        "operationId": "listAdminProducts",
        "summary": "List every product for the admin screen",
        "description": "Admins only; anyone else gets 403.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProductList"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createAdminProduct",
        "summary": "Add a product from the admin screen",
        "description": "Admins only. An affiliate or own-brand product needs a link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProduct"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admin/products/{id}": {
      "put": {
        "operationId": "updateAdminProduct",
        "summary": "Change a product's link, affiliate label or on/off state",
        "description": "Admins only. Send only the fields to change; `url: null` goes back to the catalog's link.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The product's id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAdminProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProduct"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteAdminProduct",
        "summary": "Remove a product added from the admin screen",
        "description": "Admins only. Catalog products can't be removed, only turned off.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The product's id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done; no content"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/telemetry/sleep": {
      "post": {
        "operationId": "ingestSleep",
        "summary": "Store sleep sessions",
        "description": "A session replaces any stored session from the same source that overlaps it. Sleep must end after it starts, last at most 24 hours and not end in the future.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestSleepRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/telemetry/screen-time": {
      "post": {
        "operationId": "ingestScreenTime",
        "summary": "Store screen-time samples",
        "description": "Samples upsert on source and windowStart. Minutes can't exceed the window length.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestScreenTimeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cognitoIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The Cognito ID token of the signed-in user."
      }
    },
    "responses": {
      "Error": {
        "description": "Any failure. `message` is written for the user and can be shown as is.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "AdminProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "catalogUrl": {
            "type": "string",
            "format": "uri"
          },
          "affiliate": {
            "type": "boolean"
          },
          "ownBrand": {
            "type": "boolean"
          },
          "supplement": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "managedBy": {
            "type": "string",
            "enum": [
              "catalog",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "affiliate",
          "ownBrand",
          "supplement",
          "tags",
          "enabled",
          "managedBy"
        ]
      },
      "AdminProductList": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminProduct"
            }
          }
        },
        "required": [
          "products"
        ]
      },
      "AnalyzeMealRequest": {
        "type": "object",
        "properties": {
          "photoKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "photoKey"
        ]
      },
      "AnalyzeMealResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FoodItem"
            }
          },
          "problem": {
            "type": "string",
            "enum": [
              "too_dark",
              "no_food_found",
              "blurry"
            ]
          }
        },
        "required": [
          "items"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "BioProfile": {
        "type": "object",
        "properties": {
          "wake": {
            "type": "string",
            "enum": [
              "before_6",
              "6_to_8",
              "after_8"
            ]
          },
          "fasting": {
            "type": "string",
            "enum": [
              "16_8",
              "omad",
              "12_12",
              "none"
            ]
          },
          "coffeeType": {
            "type": "string",
            "enum": [
              "biohacked",
              "black",
              "espresso",
              "none"
            ]
          },
          "coffeeTime": {
            "type": "string",
            "enum": [
              "before_9",
              "9_to_11",
              "afternoon"
            ]
          },
          "coffeeMoldTested": {
            "type": "boolean"
          },
          "moldSensitive": {
            "type": "boolean"
          },
          "eveningScreens": {
            "type": "string",
            "enum": [
              "none",
              "1_2",
              "3_plus"
            ]
          },
          "phoneAtNight": {
            "type": "string",
            "enum": [
              "airplane_mode",
              "another_room",
              "nightstand",
              "next_to_head"
            ]
          },
          "water": {
            "type": "string",
            "enum": [
              "filtered",
              "spring",
              "tap"
            ]
          },
          "addsMinerals": {
            "type": "boolean"
          },
          "coldTherapy": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "never"
            ]
          },
          "redLight": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "never"
            ]
          },
          "pemf": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "never"
            ]
          },
          "takesSupplements": {
            "type": "boolean"
          },
          "supplements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "c8_mct",
                "magnesium_l_threonate",
                "l_theanine",
                "creatine",
                "ashwagandha",
                "rhodiola",
                "binders",
                "ketone_esters",
                "methyl_b",
                "nootropics"
              ]
            }
          },
          "movement": {
            "type": "string",
            "enum": [
              "heavy_lifting",
              "rehit",
              "chronic_cardio",
              "mobility",
              "none"
            ]
          },
          "friction": {
            "type": "string",
            "enum": [
              "afternoon_crash",
              "night_waking",
              "post_meal_fog",
              "slow_recovery"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "focus",
              "deep_sleep",
              "steady_energy",
              "longevity"
            ]
          }
        },
        "required": [
          "wake",
          "fasting",
          "coffeeType",
          "moldSensitive",
          "eveningScreens",
          "phoneAtNight",
          "water",
          "addsMinerals",
          "coldTherapy",
          "redLight",
          "pemf",
          "takesSupplements",
          "supplements",
          "movement",
          "friction",
          "goal"
        ]
      },
      "BioState": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "calorieTarget": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "caloriesEaten": {
            "type": "number",
            "minimum": 0
          },
          "macrosEaten": {
            "$ref": "#/components/schemas/Macros"
          },
          "macroTargets": {
            "$ref": "#/components/schemas/Macros"
          },
          "macroFocus": {
            "$ref": "#/components/schemas/MacroFocus"
          },
          "cognitiveFlags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CognitiveFlag"
            }
          },
          "dietaryPreference": {
            "$ref": "#/components/schemas/DietaryPreference"
          }
        },
        "required": [
          "date",
          "calorieTarget",
          "caloriesEaten",
          "macrosEaten",
          "macroTargets",
          "macroFocus",
          "cognitiveFlags",
          "dietaryPreference"
        ]
      },
      "CheckIn": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "flags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CognitiveFlag"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 280
          }
        },
        "required": [
          "id",
          "at",
          "flags"
        ]
      },
      "CognitiveFlag": {
        "type": "string",
        "enum": [
          "sharp",
          "low_focus",
          "brain_fog",
          "low_energy",
          "wired",
          "stressed",
          "calm"
        ]
      },
      "CognitiveGoal": {
        "type": "string",
        "enum": [
          "focus",
          "calm",
          "energy",
          "sleep"
        ]
      },
      "CreateAdminProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          },
          "affiliate": {
            "type": "boolean"
          },
          "ownBrand": {
            "type": "boolean"
          },
          "supplement": {
            "type": "boolean"
          },
          "tags": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "required": [
          "name",
          "description",
          "affiliate",
          "ownBrand",
          "supplement",
          "tags"
        ]
