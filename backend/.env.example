# All optional for `npm run dev`: without them the dev server uses an in-memory
# Postgres and stub AI/search responses. The Lambda requires all of them.
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Comma-separated recipe sites; defaults to the list in src/infrastructure/config.ts
RECIPE_ALLOWED_DOMAINS=
