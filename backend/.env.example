# All optional for `npm run dev`: without them the dev server uses an in-memory
# Postgres and stub AI/search responses. The Lambda requires all of them.
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Recipe search: the first of these that is set is used. Tavily (https://tavily.com) has a free
# plan; Brave is https://api-dashboard.search.brave.com. The Google pair is only for projects
# that already had Custom Search access; Google no longer accepts new ones.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Comma-separated recipe sites; defaults to the list in src/infrastructure/config.ts
RECIPE_ALLOWED_DOMAINS=
# Comma-separated sign-in emails allowed to manage products (the dev server treats its user as admin)
ADMIN_EMAILS=
